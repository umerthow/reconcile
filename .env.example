# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_NAME=recon_db
DB_USER=recon_user
DB_PASSWORD=recon_pass

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka Configuration (assumes external Kafka on host)
KAFKA_BROKERS=host.docker.internal:29092
KAFKA_GROUP_ID=recon-worker-group
KAFKA_SSL_ENABLE=false
KAFKA_USERNAME=
KAFKA_PASSWORD=

# Custody Provider API
CUSTODY_API_URL=https://api.custody-provider.com
CUSTODY_API_KEY=mock-custody-api-key

# Application Configuration
GO_ENV=development
LOG_LEVEL=info
PORT=8080
JWT_SECRET=dev-secret-key-change-in-production-min-32-chars

# Worker Configuration
POLLING_INTERVAL_SEC=300
WORKER_CONCURRENCY=5
MAX_RETRIES=3
RETRY_BACKOFF_SEC=2
